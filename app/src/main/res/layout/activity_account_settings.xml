<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:background="@color/app_background" android:fillViewport="true" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/app_background" android:padding="24dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageButton android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_back_circle" android:src="@drawable/ic_back" android:contentDescription="Kembali"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Pengaturan Akun" android:textColor="@color/primary_orange" android:textSize="19sp" android:textStyle="bold"/><Space android:layout_width="40dp" android:layout_height="1dp"/></LinearLayout>
 <FrameLayout android:layout_width="168dp" android:layout_height="168dp" android:layout_gravity="center_horizontal" android:layout_marginTop="32dp">
<ImageView android:id="@+id/iv_photo" android:layout_width="168dp" android:layout_height="168dp" android:layout_gravity="center_horizontal"  android:background="@drawable/bg_avatar_placeholder" android:padding="26dp" android:src="@drawable/ic_user" android:contentDescription="Pilih foto guru"/>
<ImageButton android:id="@+id/btn_change_photo" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="bottom|end" android:background="@drawable/bg_back_circle" android:padding="12dp" android:src="@drawable/ic_camera" android:contentDescription="Tambah atau ganti foto"/>
</FrameLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Ketuk untuk mengganti foto" android:textColor="@color/primary_orange" android:textSize="12sp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="36dp" android:text="Nama Lengkap Guru" android:textColor="@color/text_primary"/>
 <EditText android:id="@+id/et_name" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:paddingHorizontal="14dp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Nomor Induk Pegawai" android:textColor="@color/text_primary"/>
 <EditText android:id="@+id/et_nip" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:paddingHorizontal="14dp"/>
 <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" android:layout_width="match_parent" android:layout_height="52dp" android:text="Simpan" android:textAllCaps="false" android:textColor="@color/white" app:backgroundTint="@color/primary_orange" app:cornerRadius="14dp"/>
</LinearLayout>
</ScrollView>
