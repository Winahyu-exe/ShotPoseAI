<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/app_background" android:fitsSystemWindows="true" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><ImageButton android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_back_circle" android:src="@drawable/ic_back" android:contentDescription="Kembali"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Profile Guru" android:textColor="@color/primary_orange" android:textSize="19sp" android:textStyle="bold"/><Space android:layout_width="40dp" android:layout_height="1dp"/></LinearLayout>
 <FrameLayout android:layout_width="168dp" android:layout_height="168dp" android:layout_gravity="center_horizontal" android:layout_marginTop="32dp">
<ImageView android:id="@+id/iv_photo" android:layout_width="168dp" android:layout_height="168dp" android:layout_gravity="center_horizontal"  android:background="@drawable/bg_avatar_placeholder" android:padding="26dp" android:src="@drawable/ic_user" android:contentDescription="Foto guru"/>
<ImageButton android:id="@+id/btn_change_photo" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="bottom|end" android:background="@drawable/bg_back_circle" android:padding="12dp" android:src="@drawable/ic_camera" android:contentDescription="Tambah atau ganti foto"/>
</FrameLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Ketuk untuk mengganti foto" android:textColor="@color/primary_orange" android:textSize="12sp"/>
 <TextView android:id="@+id/tv_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:orientation="horizontal" android:minHeight="112dp"><TextView android:id="@+id/tv_students" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_profile_blue" android:gravity="center" android:textAlignment="center" android:textColor="@color/info_blue_dark" android:textSize="18sp" android:textStyle="bold"/><Space android:layout_width="20dp" android:layout_height="1dp"/><TextView android:id="@+id/tv_classes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_profile_yellow" android:gravity="center" android:textAlignment="center" android:textColor="#875706" android:textSize="18sp" android:textStyle="bold"/></LinearLayout>
 <TextView android:id="@+id/btn_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:paddingHorizontal="18dp" android:text="👤   Pengaturan Akun" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" android:drawableEnd="@drawable/ic_arrow_right" android:drawablePadding="12dp" android:minHeight="68dp" android:paddingVertical="12dp"/>
 <TextView android:id="@+id/btn_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:paddingHorizontal="18dp" android:text="ⓘ   Bantuan dan Dukungan" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" android:drawableEnd="@drawable/ic_arrow_right" android:drawablePadding="12dp" android:minHeight="68dp" android:paddingVertical="12dp"/>
 <Space android:layout_width="1dp" android:layout_height="24dp"/>
 <com.google.android.material.button.MaterialButton android:id="@+id/btn_logout" android:layout_width="match_parent" android:layout_height="52dp" android:text="⇥  Logout" android:textAllCaps="false" android:textColor="@color/white" app:backgroundTint="@color/danger_red" app:cornerRadius="14dp"/>
</LinearLayout>
</ScrollView>
