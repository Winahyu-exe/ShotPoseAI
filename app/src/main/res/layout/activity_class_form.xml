<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/app_background" android:fillViewport="true" android:fitsSystemWindows="true" android:clipToPadding="false">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical"><ImageButton android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_back_circle" android:src="@drawable/ic_back" android:contentDescription="Kembali"/><TextView android:id="@+id/tv_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Tambah Kelas" android:textColor="@color/primary_orange" android:textSize="19sp" android:textStyle="bold"/><Space android:layout_width="40dp" android:layout_height="1dp"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="👤   Nama Kelas" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
   <EditText android:id="@+id/et_name" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="Contoh: Kelas X-A" android:paddingHorizontal="12dp" android:singleLine="true"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="◫   Pilih Olahraga" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
   <RadioGroup android:id="@+id/rg_icon" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
    <RadioButton android:id="@+id/rb_ball" style="@style/SportTile" android:checked="true" android:text="⚽\nSepak\nbola" android:layout_height="wrap_content" android:minHeight="88dp"/>
    <RadioButton android:id="@+id/rb_basket" style="@style/SportTileDisabled" android:text="🏀\nBasket" android:layout_height="wrap_content" android:minHeight="88dp"/>
    <RadioButton android:id="@+id/rb_volley" style="@style/SportTileDisabled" android:text="🏐\nVoli" android:layout_height="wrap_content" android:minHeight="88dp"/>
    <RadioButton android:id="@+id/rb_badminton" style="@style/SportTileDisabled" android:text="🏸\nBulu\ntangkis" android:layout_height="wrap_content" android:minHeight="88dp"/>
    <RadioButton android:id="@+id/rb_run" style="@style/SportTileDisabled" android:text="🏃\nAtletik" android:layout_height="wrap_content" android:minHeight="88dp"/>
   </RadioGroup>
   <TextView android:id="@+id/tv_sport_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Olahraga lain segera tersedia" android:textColor="@color/text_secondary" android:textSize="11sp"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="◎   Pilih Kategori" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
<com.google.android.material.chip.ChipGroup android:id="@+id/category_chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="8dp"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="♟   Tambahkan Siswa" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
   <EditText android:id="@+id/et_search" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="Cari siswa" android:paddingHorizontal="12dp" android:singleLine="true"/>
   <LinearLayout android:id="@+id/student_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/btn_all_students" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="Lihat Semua Siswa" android:textAllCaps="false" android:textColor="@color/primary_orange" app:backgroundTint="@color/white" app:strokeColor="@color/primary_orange" app:strokeWidth="1dp"/>
  </LinearLayout>
  <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="24dp" android:text="Simpan" android:textAllCaps="false" android:textColor="@color/white" app:backgroundTint="@color/primary_orange" app:cornerRadius="14dp"/>
 </LinearLayout>
</ScrollView>
